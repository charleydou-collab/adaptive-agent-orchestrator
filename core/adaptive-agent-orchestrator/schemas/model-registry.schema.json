{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Model registry",
  "type": "object",
  "properties": {
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string",
            "minLength": 1
          },
          "model_id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "capability_tiers": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "economy",
                "balanced",
                "advanced",
                "specialist"
              ]
            }
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "cost_class": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "approval_policy": {
            "enum": [
              "none",
              "explicit-user-approval"
            ],
            "description": "Dispatch consent boundary. High-cost targets must require explicit user approval."
          },
          "context_window": {
            "type": "integer",
            "minimum": 1
          },
          "modalities": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "tools": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "supported_efforts": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "reasoning_mapping": {
            "type": "object",
            "properties": {
              "minimal": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "standard": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "deep": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "minimal",
              "standard",
              "deep"
            ],
            "additionalProperties": false
          },
          "availability": {
            "enum": [
              "available",
              "unavailable",
              "unknown"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "cost_class": {
                  "const": "high"
                }
              }
            },
            "then": {
              "properties": {
                "approval_policy": {
                  "const": "explicit-user-approval"
                }
              }
            }
          }
        ],
        "required": [
          "provider",
          "model_id",
          "version",
          "capability_tiers",
          "capabilities",
          "cost_class",
          "approval_policy",
          "context_window",
          "modalities",
          "tools",
          "supported_efforts",
          "reasoning_mapping",
          "availability"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "models"
  ],
  "additionalProperties": false
}
