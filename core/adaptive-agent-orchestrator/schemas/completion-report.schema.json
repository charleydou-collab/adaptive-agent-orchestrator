{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Canonical completion report",
  "type": "object",
  "properties": {
    "status": {
      "enum": [
        "complete",
        "partial",
        "needs-input",
        "blocked",
        "failed"
      ]
    },
    "deliverable": {
      "type": ["string", "null"]
    },
    "kpi_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "kpi_id": {
            "type": "string",
            "minLength": 1
          },
          "outcome": {
            "enum": [
              "pass",
              "fail",
              "not-evaluated"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "required": [
          "kpi_id",
          "outcome",
          "evidence_refs"
        ],
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "escalation_recommendation": {
      "type": "object",
      "properties": {
        "recommended": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "recommended",
        "reason"
      ],
      "additionalProperties": false
    },
    "clarification_request": {
      "$ref": "clarification-request.schema.json"
    }
  },
  "required": [
    "status",
    "deliverable",
    "kpi_results",
    "evidence",
    "uncertainties",
    "blockers",
    "escalation_recommendation"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "needs-input"}}},
      "then": {"required": ["clarification_request"]},
      "else": {"properties": {"deliverable": {"type": "string", "minLength": 1}}}
    }
  ]
}
