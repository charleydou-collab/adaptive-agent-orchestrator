{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Worker clarification request",
  "type": "object",
  "properties": {
    "request_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "question": {"type": "string", "minLength": 1},
    "why_needed": {"type": "string", "minLength": 1},
    "blocked_scope": {"type": "string", "minLength": 1},
    "options": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "properties": {
          "option_id": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1}
        },
        "required": ["option_id", "label", "description"],
        "additionalProperties": false
      }
    },
    "recommended_option_id": {"type": "string", "minLength": 1},
    "custom_response_allowed": {"const": true},
    "safe_assumption": {
      "type": "object",
      "properties": {
        "available": {"type": "boolean"},
        "value": {"type": ["string", "null"]},
        "risk": {"type": "string", "minLength": 1}
      },
      "required": ["available", "value", "risk"],
      "additionalProperties": false
    }
  },
  "required": [
    "request_id", "task_id", "question", "why_needed", "blocked_scope",
    "options", "recommended_option_id", "custom_response_allowed", "safe_assumption"
  ],
  "additionalProperties": false
}
