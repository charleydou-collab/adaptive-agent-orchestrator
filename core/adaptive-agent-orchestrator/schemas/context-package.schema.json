{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bounded compiled context package",
  "type": "object",
  "$defs": {
    "omission": {
      "type": "object",
      "properties": {"ref": {"type": "string", "minLength": 1}, "reason_code": {"enum": ["budget", "irrelevant", "superseded", "expired", "unavailable"]}},
      "required": ["ref", "reason_code"],
      "additionalProperties": false
    }
  },
  "properties": {
    "package_id": {"type": "string", "minLength": 1},
    "conversation_key": {"type": "string", "minLength": 1},
    "audience": {"enum": ["management", "worker"]},
    "task_id": {"type": "string", "minLength": 1},
    "capsule_ref": {"type": ["string", "null"]},
    "selected_lesson_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "selected_episode_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "selected_recent_turn_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "required_input_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "omissions": {"type": "array", "items": {"$ref": "#/$defs/omission"}},
    "component_token_estimates": {
      "type": "object",
      "properties": {"policy": {"type": "integer", "minimum": 0}, "capsule": {"type": "integer", "minimum": 0}, "lessons": {"type": "integer", "minimum": 0}, "episodes": {"type": "integer", "minimum": 0}, "recent_turns": {"type": "integer", "minimum": 0}},
      "required": ["policy", "capsule", "lessons", "episodes", "recent_turns"],
      "additionalProperties": false
    },
    "total_estimated_tokens": {"type": "integer", "minimum": 0},
    "required_input_token_estimate": {"type": "integer", "minimum": 0},
    "required_input_limit": {"type": "integer", "minimum": 0, "maximum": 32000},
    "estimate_quality": {"enum": ["exact", "approximate", "unavailable"]},
    "budget_status": {"enum": ["within-budget", "compressed", "max-budget", "unbounded-override"]},
    "rehydration_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "created_at": {"type": "string", "minLength": 1}
  },
  "required": ["package_id", "conversation_key", "audience", "task_id", "capsule_ref", "selected_lesson_ids", "selected_episode_ids", "selected_recent_turn_refs", "required_input_refs", "omissions", "component_token_estimates", "total_estimated_tokens", "required_input_token_estimate", "required_input_limit", "estimate_quality", "budget_status", "rehydration_refs", "created_at"],
  "additionalProperties": false
}
