{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Metadata-only ledger event",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "adapter": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "platform": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "agent_identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "archetype": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "role": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "task_category": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "capability_tier": {
      "enum": [
        "economy",
        "balanced",
        "advanced",
        "specialist"
      ]
    },
    "abstract_effort": {
      "enum": [
        "minimal",
        "standard",
        "deep"
      ]
    },
    "execution_fingerprint": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "model_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "uniqueItems": true
        },
        "modalities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "effort": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "effort_mapping": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "provider",
        "model_id",
        "version",
        "tools",
        "modalities",
        "effort",
        "effort_mapping"
      ],
      "additionalProperties": false
    },
    "kpi_outcome": {
      "enum": [
        "pass",
        "fail",
        "partial",
        "not-evaluated"
      ]
    },
    "verified": {
      "const": true
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "delta": {
      "type": "number",
      "minimum": -200,
      "maximum": 200
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "score_update_mode": {
      "enum": [
        "apply",
        "freeze"
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "correction_of": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "equivalence_of": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "corrective_lesson": {
      "type": "string",
      "maxLength": 512
    }
  },
  "required": [
    "event_id",
    "task_id",
    "adapter",
    "platform",
    "agent_identity",
    "archetype",
    "role",
    "task_category",
    "capability_tier",
    "abstract_effort",
    "execution_fingerprint",
    "kpi_outcome",
    "verified",
    "evidence_refs",
    "delta",
    "reason",
    "score_update_mode",
    "timestamp"
  ],
  "additionalProperties": false,
  "description": "Closed metadata record. Evidence fields contain opaque references only. Full prompts, source documents, sensitive source material and complete outputs must never be stored, including in reason or lesson text. Semantic content checks remain the ledger writer's responsibility. Freeze records proposed delta without changing scores; correction_of links the original deduction."
}
