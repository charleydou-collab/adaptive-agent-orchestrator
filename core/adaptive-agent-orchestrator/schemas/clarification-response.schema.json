{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "User clarification response",
  "type": "object",
  "properties": {
    "request_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "selected_option_id": {"type": ["string", "null"]},
    "custom_response": {"type": ["string", "null"]},
    "answer_text": {"type": "string", "minLength": 1},
    "answered_by": {"const": "user"},
    "answered_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    }
  },
  "required": [
    "request_id", "task_id", "selected_option_id", "custom_response",
    "answer_text", "answered_by", "answered_at"
  ],
  "additionalProperties": false
}
