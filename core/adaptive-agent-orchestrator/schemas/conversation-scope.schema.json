{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Conversation storage scope",
  "type": "object",
  "properties": {
    "adapter": {"type": "string", "minLength": 1, "maxLength": 128},
    "conversation_id": {"type": "string", "minLength": 1, "maxLength": 512},
    "persistence_class": {"enum": ["durable", "session", "none"]},
    "storage_ref": {"type": ["string", "null"], "maxLength": 512}
  },
  "required": ["adapter", "conversation_id", "persistence_class", "storage_ref"],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"properties": {"persistence_class": {"const": "none"}}},
      "then": {"properties": {"storage_ref": {"const": null}}},
      "else": {"properties": {"storage_ref": {"type": "string", "minLength": 1}}}
    }
  ]
}
