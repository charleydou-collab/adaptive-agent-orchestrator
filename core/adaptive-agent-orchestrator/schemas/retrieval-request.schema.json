{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Chat context retrieval request",
  "type": "object",
  "properties": {
    "conversation_key": {"type": "string", "minLength": 1, "maxLength": 128},
    "task_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "task_category": {"type": "string", "minLength": 1, "maxLength": 128},
    "role": {"type": "string", "minLength": 1, "maxLength": 128},
    "topics": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 256}, "uniqueItems": true, "maxItems": 64},
    "entities": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 256}, "uniqueItems": true, "maxItems": 64},
    "required_evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 512}, "uniqueItems": true, "maxItems": 128},
    "applicability_facts": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 512}, "uniqueItems": true, "maxItems": 64},
    "lesson_limit": {"type": "integer", "minimum": 0, "maximum": 5},
    "episode_limit": {"type": "integer", "minimum": 0, "maximum": 20},
    "full_context": {"type": "boolean"}
  },
  "required": ["conversation_key", "task_id", "task_category", "role", "topics", "entities", "required_evidence_refs", "applicability_facts", "lesson_limit", "episode_limit", "full_context"],
  "additionalProperties": false
}
