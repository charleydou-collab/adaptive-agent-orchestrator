{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bounded chat state capsule",
  "type": "object",
  "$defs": {
    "entry": {
      "type": "object",
      "properties": {
        "text": {"type": "string", "minLength": 1, "maxLength": 2000},
        "source_refs": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 256}, "uniqueItems": true, "minItems": 1, "maxItems": 16}
      },
      "required": ["text", "source_refs"],
      "additionalProperties": false
    }
  },
  "properties": {
    "conversation_key": {"type": "string", "minLength": 1, "maxLength": 128},
    "revision": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "objectives": {"type": "array", "items": {"$ref": "#/$defs/entry"}, "maxItems": 32},
    "decisions": {"type": "array", "items": {"$ref": "#/$defs/entry"}, "maxItems": 32},
    "constraints": {"type": "array", "items": {"$ref": "#/$defs/entry"}, "maxItems": 32},
    "open_questions": {"type": "array", "items": {"$ref": "#/$defs/entry"}, "maxItems": 32},
    "accepted_facts": {"type": "array", "items": {"$ref": "#/$defs/entry"}, "maxItems": 32},
    "active_preferences": {"type": "array", "items": {"$ref": "#/$defs/entry"}, "maxItems": 32},
    "artifact_refs": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 512}, "uniqueItems": true, "maxItems": 32},
    "updated_at": {"type": "string", "minLength": 1, "maxLength": 64}
  },
  "required": ["conversation_key", "revision", "objectives", "decisions", "constraints", "open_questions", "accepted_facts", "active_preferences", "artifact_refs", "updated_at"],
  "additionalProperties": false
}
